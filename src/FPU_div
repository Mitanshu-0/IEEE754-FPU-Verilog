module FPU_div (
    input  wire [31:0] a,
    input  wire [31:0] b,
    input  wire        enable,
    output reg  [31:0] result,
    output reg         overflow,
    output reg         underflow,
    output reg         div_by_zero,
    output reg         invalid,
    output reg         inexact
);

wire        sign_a = a[31];
wire        sign_b = b[31];
wire [7:0]  exp_a  = a[30:23];
wire [7:0]  exp_b  = b[30:23];
wire [22:0] mant_a = a[22:0];
wire [22:0] mant_b = b[22:0];

wire is_zero_a   = (exp_a == 8'h00) && (mant_a == 23'h0);
wire is_zero_b   = (exp_b == 8'h00) && (mant_b == 23'h0);
wire is_denorm_a = (exp_a == 8'h00) && (mant_a != 23'h0);
wire is_denorm_b = (exp_b == 8'h00) && (mant_b != 23'h0);
wire is_inf_a    = (exp_a == 8'hFF) && (mant_a == 23'h0);
wire is_inf_b    = (exp_b == 8'hFF) && (mant_b == 23'h0);
wire is_nan_a    = (exp_a == 8'hFF) && (mant_a != 23'h0);
wire is_nan_b    = (exp_b == 8'hFF) && (mant_b != 23'h0);

wire is_zd_a = is_zero_a | is_denorm_a;
wire is_zd_b = is_zero_b | is_denorm_b;

reg        sign_c;

reg [23:0] sig_a;
reg [23:0] sig_b;

reg signed [10:0] exp_diff;

reg [24:0] A;
reg [25:0] Q;

reg [22:0] mant_norm;
reg signed [10:0] exp_norm;

reg G;
reg R;
reg S;

reg inexact_w;
reg round_up;

reg [23:0] mant_rounded;
reg signed [10:0] exp_final;
reg [22:0] mant_final;

reg ovf;
reg unf;

reg [31:0] normal_result;

integer b_idx;

always @(*) begin

    result      = 32'b0;
    overflow    = 1'b0;
    underflow   = 1'b0;
    div_by_zero = 1'b0;
    invalid     = 1'b0;
    inexact     = 1'b0;

    if (enable) begin

        if (is_nan_a || is_nan_b ||
            (is_inf_a && is_inf_b) ||
            (is_zd_a && is_zd_b)) begin

            result  = 32'h7FC0_0000;
            invalid = 1'b1;

        end

        else if (is_inf_a && !is_inf_b) begin

            sign_c = sign_a ^ sign_b;
            result = {sign_c, 8'hFF, 23'h0};

        end

        else if (is_inf_b && !is_inf_a) begin

            sign_c = sign_a ^ sign_b;
            result = {sign_c, 31'h0};

        end

        else if (is_zd_a && !is_zd_b) begin

            sign_c = sign_a ^ sign_b;
            result = {sign_c, 31'h0};

        end

        else if (is_zd_b && !is_zd_a) begin

            sign_c     = sign_a ^ sign_b;
            result     = {sign_c, 8'hFF, 23'h0};
            div_by_zero = 1'b1;

        end

        else begin

            sign_c = sign_a ^ sign_b;

            sig_a = {1'b1, mant_a};
            sig_b = {1'b1, mant_b};

            exp_diff = {3'b000, exp_a} -
                       {3'b000, exp_b} +
                       11'sd127;

            Q = 26'b0;

            if (sig_a >= sig_b) begin
                Q[25] = 1'b1;
                A = {1'b0, sig_a} - {1'b0, sig_b};
            end
            else begin
                Q[25] = 1'b0;
                A = {1'b0, sig_a};
            end

            for (b_idx = 24; b_idx >= 0; b_idx = b_idx - 1) begin

                A = A << 1;

                if (A >= {1'b0, sig_b}) begin
                    Q[b_idx] = 1'b1;
                    A = A - {1'b0, sig_b};
                end
                else begin
                    Q[b_idx] = 1'b0;
                end

            end

            mant_norm = Q[25] ? Q[24:2] :
                                  Q[23:1];

            G = Q[25] ? Q[1] : Q[0];

            R = Q[25] ? Q[0] : 1'b0;

            S = (A != 25'b0);

            exp_norm = Q[25] ? exp_diff :
                              exp_diff - 11'sd1;

            inexact_w = G | R | S;

            round_up = G & (R | S | mant_norm[0]);

            mant_rounded = {1'b0, mant_norm} +
                           {23'h0, round_up};

            exp_final = mant_rounded[23] ?
                        exp_norm + 11'sd1 :
                        exp_norm;

            mant_final = mant_rounded[23] ?
                         mant_rounded[23:1] :
                         mant_rounded[22:0];

            ovf = (exp_final >= 11'sd255);
            unf = (exp_final <= 11'sd0);

            normal_result = {sign_c, exp_final[7:0], mant_final};

            if (ovf) begin

                result   = {sign_c, 8'hFF, 23'h0};
                overflow = 1'b1;
                inexact  = 1'b1;

            end

            else if (unf) begin

                result    = {sign_c, 31'h0};
                underflow = 1'b1;
                inexact   = 1'b1;

            end

            else begin

                result  = normal_result;
                inexact = inexact_w;

            end

        end
    end

endmodule
