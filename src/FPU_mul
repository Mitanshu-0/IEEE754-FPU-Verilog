module FPU_mul (
    input  wire [31:0] a,
    input  wire [31:0] b,
    input  wire        enable,
    output reg  [31:0] result,
    output reg         overflow,
    output reg         underflow,
    output reg         invalid,
    output reg         inexact
);

wire        sign_a = a[31];
wire        sign_b = b[31];
wire [7:0]  exp_a  = a[30:23];
wire [7:0]  exp_b  = b[30:23];
wire [22:0] mant_a = a[22:0];
wire [22:0] mant_b = b[22:0];

wire is_zero_a   = (exp_a == 8'h00) && (mant_a == 23'h0);
wire is_zero_b   = (exp_b == 8'h00) && (mant_b == 23'h0);
wire is_denorm_a = (exp_a == 8'h00) && (mant_a != 23'h0);
wire is_denorm_b = (exp_b == 8'h00) && (mant_b != 23'h0);
wire is_inf_a    = (exp_a == 8'hFF) && (mant_a == 23'h0);
wire is_inf_b    = (exp_b == 8'hFF) && (mant_b == 23'h0);
wire is_nan_a    = (exp_a == 8'hFF) && (mant_a != 23'h0);
wire is_nan_b    = (exp_b == 8'hFF) && (mant_b != 23'h0);

wire is_zero_or_denorm_a = is_zero_a | is_denorm_a;
wire is_zero_or_denorm_b = is_zero_b | is_denorm_b;

reg        sign_c;
reg [23:0] mant_a_full;
reg [23:0] mant_b_full;

reg [47:0] product;

reg signed [10:0] exp_sum;
reg               norm_bit;

reg [22:0]        mant_norm;
reg signed [10:0] exp_norm;

reg G, R, S;

reg               inexact_w;
reg               round_up;

reg [23:0]        mant_rounded;
reg signed [10:0] exp_final;
reg [22:0]        mant_final;

reg               ovf, unf;
reg [31:0]        normal_result;

always @(*) begin

    result    = 32'b0;
    overflow  = 1'b0;
    underflow = 1'b0;
    invalid   = 1'b0;
    inexact   = 1'b0;

    if (enable) begin

        if (is_nan_a || is_nan_b ||
            (is_zero_or_denorm_a && is_inf_b) ||
            (is_inf_a && is_zero_or_denorm_b)) begin

            result  = 32'h7FC0_0000;
            invalid = 1'b1;

        end

        else if (is_inf_a || is_inf_b) begin

            sign_c = sign_a ^ sign_b;
            result = {sign_c, 8'hFF, 23'h0};

        end

        else if (is_zero_or_denorm_a ||
                 is_zero_or_denorm_b) begin

            sign_c = sign_a ^ sign_b;
            result = {sign_c, 31'h0};

        end

        else begin

            sign_c = sign_a ^ sign_b;

            mant_a_full = {1'b1, mant_a};
            mant_b_full = {1'b1, mant_b};

            product = {{24{1'b0}}, mant_a_full} *
                      {{24{1'b0}}, mant_b_full};

            exp_sum = {3'b000, exp_a} +
                      {3'b000, exp_b} -
                      11'sd127;

            norm_bit = product[47];

            mant_norm = norm_bit ? product[46:24] :
                                    product[45:23];

            exp_norm = norm_bit ? exp_sum + 11'sd1 :
                                   exp_sum;

            G = norm_bit ? product[23] :
                           product[22];

            R = norm_bit ? product[22] :
                           product[21];

            S = norm_bit ? |product[21:0] :
                           |product[20:0];

            inexact_w = G | R | S;

            round_up = G & (R | S | mant_norm[0]);

            mant_rounded = {1'b0, mant_norm} +
                           {23'h0, round_up};

            exp_final = mant_rounded[23] ?
                        exp_norm + 11'sd1 :
                        exp_norm;

            mant_final = mant_rounded[23] ?
                         mant_rounded[23:1] :
                         mant_rounded[22:0];

            ovf = (exp_final >= 11'sd255);
            unf = (exp_final <= 11'sd0);

            normal_result = {sign_c, exp_final[7:0], mant_final};

            if (ovf) begin

                result   = {sign_c, 8'hFF, 23'h0};
                overflow = 1'b1;
                inexact  = 1'b1;

            end

            else if (unf) begin

                result    = {sign_c, 31'h0};
                underflow = 1'b1;
                inexact   = 1'b1;

            end

            else begin

                result  = normal_result;
                inexact = inexact_w;

            end
        end
    end

endmodule
